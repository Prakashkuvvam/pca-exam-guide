---
import Layout from '../components/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PrevNext from '../components/PrevNext.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { title, description, headings = [], prev, next } = Astro.props;

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const currentSlug = Astro.url.pathname.replace(/\//g, '');
const currentIndex = docs.findIndex((d) => d.slug === currentSlug);

const prevDoc = currentIndex > 0 ? docs[currentIndex - 1] : null;
const nextDoc = currentIndex < docs.length - 1 ? docs[currentIndex + 1] : null;

const prevLink = prevDoc ? { title: prevDoc.data.title, href: `/${prevDoc.id.replace(/\.md$/, '')}/` } : undefined;
const nextLink = nextDoc ? { title: nextDoc.data.title, href: `/${nextDoc.id.replace(/\.md$/, '')}/` } : undefined;
---

<Layout title={title} description={description}>
  <Sidebar />
  <main class="flex-1 min-w-0 px-6 py-8 max-w-3xl">
    <article class="prose-pca">
      <slot />
    </article>
    <PrevNext prev={prev ?? prevLink} next={next ?? nextLink} />
  </main>
  {headings.length > 0 && <TableOfContents headings={headings} />}
</Layout>
