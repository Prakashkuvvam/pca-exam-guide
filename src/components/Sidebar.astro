---
import { getCollection } from 'astro:content';

const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);

const domains = [
  { id: 0, label: 'Introduction', icon: '📋' },
  { id: 1, label: 'Observability Concepts', icon: '👁️', weight: 18 },
  { id: 2, label: 'Prometheus Fundamentals', icon: '🏗️', weight: 20 },
  { id: 3, label: 'PromQL', icon: '📊', weight: 28 },
  { id: 4, label: 'Instrumentation & Exporters', icon: '🔧', weight: 16 },
  { id: 5, label: 'Dashboarding & Visualization', icon: '📈', weight: 8 },
  { id: 6, label: 'Service Discovery', icon: '🔍', weight: 6 },
  { id: 7, label: 'Alerting & Alertmanager', icon: '🚨', weight: 4 },
];

const currentPath = Astro.url.pathname;
---

<aside class="hidden lg:block w-64 shrink-0 border-r border-[var(--color-border)] sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto p-4">
  <nav class="space-y-1">
    <div class="px-3 py-2 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider">
      Study Guide
    </div>
    {domains.map((domain) => {
      const doc = docs.find((d) => d.data.domain === domain.id);
      const href = doc ? `/${doc.id.replace(/\.md$/, '')}/` : '#';
      const isActive = currentPath === href;
      return (
        <a
          href={href}
          class:list={[
            'flex items-center gap-2.5 px-3 py-2 rounded-md text-sm no-underline! transition-colors',
            isActive
              ? 'bg-[var(--color-primary)]/10 text-[var(--color-primary)] font-semibold'
              : 'text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-hover)] hover:text-[var(--color-text)]',
          ]}
        >
          <span class="text-base">{domain.icon}</span>
          <span class="flex-1">{domain.label}</span>
          {domain.weight && (
            <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-[var(--color-surface-alt)] border border-[var(--color-border)]">
              {domain.weight}%
            </span>
          )}
        </a>
      );
    })}
  </nav>

  <div class="mt-6 mx-3 p-3 rounded-lg bg-[var(--color-surface-alt)] border border-[var(--color-border)]">
    <div class="text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wider mb-2">
      Exam Info
    </div>
    <div class="space-y-1.5 text-xs text-[var(--color-text-secondary)]">
      <div class="flex justify-between">
        <span>Duration</span>
        <span class="font-medium text-[var(--color-text)]">90 min</span>
      </div>
      <div class="flex justify-between">
        <span>Questions</span>
        <span class="font-medium text-[var(--color-text)]">60 MCQ</span>
      </div>
      <div class="flex justify-between">
        <span>Pass Score</span>
        <span class="font-medium text-[var(--color-text)]">75%</span>
      </div>
      <div class="flex justify-between">
        <span>Cost</span>
        <span class="font-medium text-[var(--color-text)]">$250</span>
      </div>
    </div>
  </div>
</aside>
